<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.brayanspagnol.OpenMHub</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>OpenMHub</name>
  <summary>Configure MCHOSE mice and keyboards</summary>

  <developer id="io.github.brayanspagnol">
    <name>Brayan Spagnol</name>
  </developer>

  <description>
    <p>
      OpenMHub is an unofficial configurator for MCHOSE mice and keyboards. It shows the battery level, charging state and connection mode of each device, and changes the settings stored on supported devices.
    </p>
    <p>
      OpenMHub is a community project and is not affiliated with or endorsed by MCHOSE. Firmware updates are not supported; use the official software for those.
    </p>
    <p>Features:</p>
    <ul>
      <li>Battery, charging and connection mode (cable or 2.4G receiver) for every recognised device</li>
      <li>Mouse buttons, DPI stages, polling rate, debounce, lift-off distance, sleep timer and macros</li>
      <li>Keyboard lighting effects, per-key colour, key remapping on three layers and macros</li>
      <li>Up to six local profiles per device, with JSON export and import</li>
      <li>Keyboard and mouse test tools</li>
      <li>Tray icon and low-battery notifications</li>
    </ul>
    <p>
      Access to the devices needs a udev rule installed once on the host, outside the sandbox. The rule and the instructions are in the project repository.
    </p>
    <p>
      The interface is currently in Brazilian Portuguese.
    </p>
  </description>

  <launchable type="desktop-id">io.github.brayanspagnol.OpenMHub.desktop</launchable>

  <url type="homepage">https://github.com/brayanspagnol/OpenMHub</url>
  <url type="bugtracker">https://github.com/brayanspagnol/OpenMHub/issues</url>
  <url type="vcs-browser">https://github.com/brayanspagnol/OpenMHub</url>

